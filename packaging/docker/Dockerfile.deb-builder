# syntax=docker/dockerfile:1
#
# Dockerfile.deb-builder — produce socksdirect .deb packages from the
# current source tree. Run from the repo root:
#
#   docker build -t socksdirect-deb-builder \
#       -f packaging/docker/Dockerfile.deb-builder .
#   docker run --rm -v "$(pwd)/dist:/out" socksdirect-deb-builder
#
# Output: ../socksdirect_*.deb produced under /out (mounted from the
# host so artifacts survive the container).

FROM ubuntu:22.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    build-essential \
    devscripts \
    debhelper \
    fakeroot \
    libibverbs-dev \
    libmemcached-dev \
    libnuma-dev \
    rdma-core \
    python3 \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# Move debian/ into place; debhelper expects it at the root.
RUN cp -r packaging/debian /src/debian \
    && dpkg-buildpackage -us -uc -b -d || true \
    # The build may print warnings but we only care about the .deb files.
    && mkdir -p /out && cp ../*.deb /out/ 2>/dev/null || true

FROM scratch
COPY --from=builder /out /out
